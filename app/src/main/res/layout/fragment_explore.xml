<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".ExploreFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp">

            <!-- MAIN HEADING -->

            <TextView
                android:id="@+id/textview1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:gravity="start"
                android:maxLines="2"
                android:text="Discover your next read"
                android:textColor="@color/burgundy"
                android:textSize="@dimen/heading_text_size"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- SEARCH BAR -->

            <com.google.android.material.search.SearchBar
                android:id="@+id/searchbar1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="16dp"
                android:text="Search books..."
                app:backgroundTint="@color/cream"
                app:iconifiedByDefault="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textview1"
                app:strokeColor="@color/gold"
                app:strokeWidth="2dp"
                app:textCentered="false" />

            <!-- CATEGORIES TITLE -->

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:text="Categories"
                android:textColor="@color/burgundy"
                android:textSize="@dimen/section_title_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/searchbar1" />

            <!-- CATEGORY BUTTONS -->

            <LinearLayout
                android:id="@+id/categories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView2">

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="0dp"
                    android:layout_height="@dimen/category_button_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/button"
                    android:fontFamily="@font/cormorant_garamond_bold"
                    android:text="Fiction"
                    android:textColor="@color/cream"
                    android:textSize="@dimen/category_button_text_size" />

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="0dp"
                    android:layout_height="@dimen/category_button_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/button"
                    android:fontFamily="@font/cormorant_garamond_bold"
                    android:text="Romance"
                    android:textColor="@color/cream"
                    android:textSize="@dimen/category_button_text_size" />

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="0dp"
                    android:layout_height="@dimen/category_button_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/button"
                    android:fontFamily="@font/cormorant_garamond_bold"
                    android:text="RomCom"
                    android:textColor="@color/cream"
                    android:textSize="@dimen/category_button_text_size" />

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="0dp"
                    android:layout_height="@dimen/category_button_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/button"
                    android:fontFamily="@font/cormorant_garamond_bold"
                    android:text="Mystery"
                    android:textColor="@color/cream"
                    android:textSize="@dimen/category_button_text_size" />

            </LinearLayout>

            <!-- POPULAR BOOKS TITLE -->

            <TextView
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:text="Popular Books"
                android:textColor="@color/burgundy"
                android:textSize="@dimen/section_title_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/categories" />

            <!-- POPULAR BOOKS -->

            <HorizontalScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/popular_scroll_height"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <!-- BOOK 1 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/popular_card_width"
                        android:layout_height="@dimen/popular_card_height"
                        android:layout_margin="8dp"
                        android:elevation="6dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="10dp">

                            <ImageView
                                android:layout_width="@dimen/popular_image_width"
                                android:layout_height="@dimen/popular_image_height"
                                android:scaleType="fitCenter"
                                android:src="@drawable/book1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="@font/cormorant_garamond_bold"
                                android:gravity="center"
                                android:text="Obsessed\nin Silence"
                                android:textColor="@color/burgundy"
                                android:textSize="@dimen/popular_card_text_size"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- BOOK 2 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/popular_card_width"
                        android:layout_height="@dimen/popular_card_height"
                        android:layout_margin="8dp"
                        android:elevation="6dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="10dp">

                            <ImageView
                                android:layout_width="@dimen/popular_image_width"
                                android:layout_height="@dimen/popular_image_height"
                                android:scaleType="fitCenter"
                                android:src="@drawable/book2" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="@font/cormorant_garamond_bold"
                                android:gravity="center"
                                android:text="Untold\nDiary"
                                android:textColor="@color/burgundy"
                                android:textSize="@dimen/popular_card_text_size"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- BOOK 3 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/popular_card_width"
                        android:layout_height="@dimen/popular_card_height"
                        android:layout_margin="8dp"
                        android:elevation="6dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="10dp">

                            <ImageView
                                android:layout_width="@dimen/popular_image_width"
                                android:layout_height="@dimen/popular_image_height"
                                android:scaleType="fitCenter"
                                android:src="@drawable/book3" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="@font/cormorant_garamond_bold"
                                android:gravity="center"
                                android:text="When We\nLove Again"
                                android:textColor="@color/burgundy"
                                android:textSize="@dimen/popular_card_text_size"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- BOOK 4 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/popular_card_width"
                        android:layout_height="@dimen/popular_card_height"
                        android:layout_margin="8dp"
                        android:elevation="6dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="10dp">

                            <ImageView
                                android:layout_width="@dimen/popular_image_width"
                                android:layout_height="@dimen/popular_image_height"
                                android:scaleType="fitCenter"
                                android:src="@drawable/book4" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="@font/cormorant_garamond_bold"
                                android:gravity="center"
                                android:text="Nothing Is\nBetween Us"
                                android:textColor="@color/burgundy"
                                android:textSize="@dimen/popular_card_text_size"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- BOOK 5 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/popular_card_width"
                        android:layout_height="@dimen/popular_card_height"
                        android:layout_margin="8dp"
                        android:elevation="6dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="10dp">

                            <ImageView
                                android:layout_width="@dimen/popular_image_width"
                                android:layout_height="@dimen/popular_image_height"
                                android:scaleType="fitCenter"
                                android:src="@drawable/book5" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="@font/cormorant_garamond_bold"
                                android:gravity="center"
                                android:text="English\nGrammar"
                                android:textColor="@color/burgundy"
                                android:textSize="@dimen/popular_card_text_size"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- TRENDING BOOKS TITLE -->

            <TextView
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:text="Trending Books"
                android:textColor="@color/burgundy"
                android:textSize="@dimen/section_title_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollView" />

            <!-- TRENDING BOOKS -->

            <HorizontalScrollView
                android:id="@+id/trendingScroll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/trending_scroll_height"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text2">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <!-- TRENDING 1 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/trending_card_size"
                        android:layout_height="@dimen/trending_card_size"
                        android:layout_margin="8dp"
                        android:elevation="5dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/book4" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- TRENDING 2 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/trending_card_size"
                        android:layout_height="@dimen/trending_card_size"
                        android:layout_margin="8dp"
                        android:elevation="5dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/book3" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- TRENDING 3 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/trending_card_size"
                        android:layout_height="@dimen/trending_card_size"
                        android:layout_margin="8dp"
                        android:elevation="5dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/book2" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- TRENDING 4 -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/trending_card_size"
                        android:layout_height="@dimen/trending_card_size"
                        android:layout_margin="8dp"
                        android:elevation="5dp"
                        app:cardBackgroundColor="@color/cream"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/book1" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </HorizontalScrollView>
<androidx.appcompat.widget.AppCompatButton
    android:layout_width="170dp"
    android:layout_marginTop="16dp"
    android:layout_height="wrap_content"
    android:text="View All"
    android:textColor="@color/cream"
    android:fontFamily="@font/cormorant_garamond_bold"
    android:background="@drawable/button"
    app:layout_constraintTop_toBottomOf="@+id/trendingScroll"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</FrameLayout>