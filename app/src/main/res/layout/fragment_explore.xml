<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".ExploreFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <TextView
            android:id="@+id/textview1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/cormorant_garamond_bold"
            android:text="Discover your next read"
            android:textColor="@color/burgundy"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.search.SearchBar
            android:id="@+id/searchbar1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:text="Search books..."
            app:backgroundTint="@color/cream"
            app:iconifiedByDefault="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textview1"
            app:strokeColor="@color/gold"
            app:strokeWidth="2dp"
            app:textCentered="false" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="260dp"
            android:fontFamily="@font/cormorant_garamond_bold"
            android:text="Categories"
            android:textColor="@color/burgundy"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/searchbar1" />

        <LinearLayout
            android:id="@+id/categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="17dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView2">

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/button"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:text="Fiction"
                android:textColor="@color/cream" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/button"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:text="Romance"
                android:textColor="@color/cream" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/button"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:text="RomCom"
                android:textColor="@color/cream" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/button"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:text="Mystery"
                android:textColor="@color/cream" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="16dp"
            android:id="@+id/text"
            android:layout_marginEnd="220dp"
            android:fontFamily="@font/cormorant_garamond_bold"
            android:text="Popular Books"
            android:textColor="@color/burgundy"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/categories" />

        <HorizontalScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="11dp"
                android:elevation="10dp"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="200dp"
                    android:layout_height="270dp"
                    android:layout_margin="10dp"
                    app:cardBackgroundColor="@color/cream"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gold"
                    >
                    <LinearLayout
                        android:layout_width="200dp"
                        android:layout_height="280dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_marginTop="12dp"
                            android:layout_width="200dp"
                            android:layout_gravity="center"
                            android:layout_height="160dp"
                            android:src="@drawable/book1" />

                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cormorant_garamond_bold"
                            android:text="Obsessed \nin Silence"
                            android:textColor="@color/burgundy"
                            android:textSize="32sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="200dp"
                    android:layout_height="270dp"
android:layout_margin="10dp"
                    app:cardBackgroundColor="@color/cream"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gold"
                    >
                    <LinearLayout
                        android:elevation="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_marginTop="12dp"
                            android:layout_width="200dp"
                            android:layout_gravity="center"
                            android:layout_height="160dp"
                            android:src="@drawable/book2" />

                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cormorant_garamond_bold"
                            android:text="Untold \nDiary"
                            android:textColor="@color/burgundy"
                            android:textSize="32sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="200dp"
                    android:layout_height="270dp"
                    android:layout_margin="10dp"
                    app:cardBackgroundColor="@color/cream"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gold"
                    >
                    <LinearLayout
                        android:elevation="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_marginTop="12dp"
                            android:layout_width="200dp"
                            android:layout_gravity="center"
                            android:layout_height="160dp"
                            android:src="@drawable/book3" />

                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cormorant_garamond_bold"
                            android:text="When We\nLove Again"
                            android:textColor="@color/burgundy"
                            android:textSize="32sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="200dp"
                    android:layout_height="270dp"
                    android:layout_margin="10dp"
                    app:cardBackgroundColor="@color/cream"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gold"
                    >
                    <LinearLayout
                        android:elevation="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_marginTop="12dp"
                            android:layout_width="200dp"
                            android:layout_gravity="center"
                            android:layout_height="160dp"
                            android:src="@drawable/book4" />
                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cormorant_garamond_bold"
                            android:text="Nothing is\nBetween Us"
                            android:textColor="@color/burgundy"
                            android:textSize="32sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="200dp"
                    android:layout_margin="10dp"
                    android:layout_height="270dp"
                    app:cardBackgroundColor="@color/cream"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gold"
                    >
                    <LinearLayout
                        android:layout_width="200dp"
                        android:layout_height="280dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_marginTop="12dp"
                            android:layout_width="200dp"
                            android:layout_gravity="center"
                            android:layout_height="160dp"
                            android:src="@drawable/book5" />

                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cormorant_garamond_bold"
                            android:text="English\nGrammar"
                            android:textColor="@color/burgundy"
                            android:textSize="32sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="16dp"
            android:id="@+id/text2"
            android:layout_marginEnd="200dp"
            android:fontFamily="@font/cormorant_garamond_bold"
            android:text="Trending Books"
            android:textColor="@color/burgundy"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollView" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text2"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:src="@drawable/book4" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
</HorizontalScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>